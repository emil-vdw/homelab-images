{
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "timezone": "Europe/Amsterdam",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/claude-code/Dockerfile$/"],
      "matchStrings": [
        "npm install -g @anthropic-ai/claude-code@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@anthropic-ai/claude-code"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/claude-code/Dockerfile$/"],
      "matchStrings": [
        "KUBECTL_VERSION=(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/claude-code/Dockerfile$/"],
      "matchStrings": [
        "FLUX_VERSION=(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/flux2"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/seerr-mcp/Dockerfile$/"],
      "matchStrings": [
        "npm install -g @cyanheads/seerr-mcp-server@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@cyanheads/seerr-mcp-server"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/truenas-mcp/Dockerfile$/"],
      "matchStrings": [
        "pip install --no-cache-dir \"mcp-proxy==(?<currentValue>[\\d.]+)\""
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "mcp-proxy"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/truenas-mcp/Dockerfile$/"],
      "matchStrings": [
        "TRUENAS_MCP_VERSION=(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "truenas/truenas-mcp"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "major"
      ],
      "groupName": "Docker base images"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "groupName": "Docker digests"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "Dockerfile pinned tool versions",
      "commitMessageTopic": "{{depName}}",
      "automerge": false
    }
  ]
}
